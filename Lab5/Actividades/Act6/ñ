$colores-tema: (
  "primario": #0d6efd,
  "exito": #198754,
  "secundario": #6c757d,
  "peligro": #dc3545
);
 
@each $nombre, $valor in $colores-tema {
  .texto-#{$nombre} {
    color: $valor;
  }
 
  .fondo-#{$nombre} {
    background-color: $valor;
  }
}

@for $i from 1 through 3 {
  .mt-#{$i} {
    margin-top: $i * 10px;
  }
}
 
 
.texto-primario { color: #0d6efd; }
.fondo-primario { background-color: #0d6efd; }
.texto-exito { color: #198754; }
.fondo-exito { background-color: #198754; }
.texto-secundario { color: #6c757d; }
.fondo-secundario { background-color: #6c757d; }
.texto-peligro { color: #dc3545; }
.fondo-peligro { background-color: #dc3545; }
 
.mt-1 { margin-top: 10px; }
.mt-2 { margin-top: 20px; }
.mt-3 { margin-top: 30px; }
