function pipeline(...transformaciones) {
  return function (valorInicial) {
    return transformaciones.reduce((valor, fn) => fn(valor), valorInicial);
  };
}

const duplicar = (n) => n * 2;
const sumarDiez = (n) => n + 10;
const cuadrado = (n) => n ** 2;
const restarTres = (n) => n - 3;

console.log("\n===== EJERCICIO 5 =====");

const operacion = pipeline(duplicar, sumarDiez, cuadrado);

console.log("operacion(5):", operacion(5));

const otraOperacion = pipeline(sumarDiez, restarTres, duplicar);

console.log("otraOperacion(5):", otraOperacion(5));
