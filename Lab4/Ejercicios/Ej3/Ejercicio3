function crearGeneradorCodigo(prefijo) {
  let contador = 0;

  return function () {
    contador++;
    return `${prefijo}-${contador}`;
  };
}

console.log("\n===== EJERCICIO 3 =====");

const generarAlumno = crearGeneradorCodigo("ALU");
const generarDocente = crearGeneradorCodigo("DOC");

